<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Szablon agenta launchd strażnika floty. Nie kopiuj ręcznie: moduly/straznik/instaluj.sh podstawia __REPO__ i __HOME__. -->
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>org.agenci.straznik</string>
	<key>ProgramArguments</key>
	<array>
		<string>/usr/bin/python3</string>
		<string>__REPO__/moduly/straznik/straznik.py</string>
	</array>
	<key>WorkingDirectory</key>
	<string>__REPO__</string>
	<key>StartInterval</key>
	<integer>900</integer>
	<key>RunAtLoad</key>
	<true/>
	<key>StandardOutPath</key>
	<string>__HOME__/Library/Logs/straznik-floty.log</string>
	<key>StandardErrorPath</key>
	<string>__HOME__/Library/Logs/straznik-floty.log</string>
	<key>EnvironmentVariables</key>
	<dict>
		<key>PATH</key>
		<string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
		<key>STRAZNIK_REPO</key>
		<string>__REPO__</string>
		<key>PYTHONIOENCODING</key>
		<string>utf-8</string>
	</dict>
</dict>
</plist>
