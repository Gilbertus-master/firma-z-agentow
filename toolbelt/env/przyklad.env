# Plik środowiska roli dla `op run` (1Password CLI). Zawiera ODWOŁANIA do sekretów, nie wartości – wolno go commitować.
# Użycie w przebiegu agenta:  op run --env-file=toolbelt/env/<rola>.env -- <polecenie>
# Kopia na rolę: toolbelt/env/ceo.env, toolbelt/env/inzynier.env … (tylko pozycje, których rola potrzebuje).
GH_TOKEN=op://agenci/github-pat-<rola>/credential
RESEND_API_KEY=op://agenci/resend-<rola>/credential
